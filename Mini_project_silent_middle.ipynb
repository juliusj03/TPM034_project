    "ct1_cols = [c for c in df.columns if c.startswith(\"ct1_\")]\n",
    "ct2_cols = [c for c in df.columns if c.startswith(\"ct2_\")]\n",
    "ct_cols  = ct1_cols + ct2_cols\n",
    "\n",
    "mct_cols = [c for c in df.columns if c.startswith(\"motct\")]\n",
